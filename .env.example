# Used by docker-compose.yml (docker compose reads .env from this directory
# automatically). Copy to .env and fill in — never commit the real .env.

MYSQL_ROOT_PASSWORD=change_me_to_something_long_and_random
SECRET_KEY=generate_with__python -c "import secrets; print(secrets.token_urlsafe(48))"
GROQ_API_KEY=

ENVIRONMENT=production
ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
